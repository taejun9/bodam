{
  "name": "bodam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "vue-tsc --build --force",
    "test:unit": "vitest run",
    "test:db": "cargo test --manifest-path src-tauri/Cargo.toml",
    "e2e:build:macos": "node e2e/build-e2e.mjs macos",
    "e2e:build": "node e2e/build-e2e.mjs no-bundle",
    "e2e:write": "wdio run wdio.conf.mjs --spec ./e2e/specs/customer-write.e2e.mjs",
    "e2e:persistence": "wdio run wdio.conf.mjs --spec ./e2e/specs/customer-persistence.e2e.mjs",
    "e2e:data-exchange-write": "wdio run wdio.conf.mjs --spec ./e2e/specs/data-exchange-write.e2e.mjs",
    "e2e:data-exchange-persistence": "wdio run wdio.conf.mjs --spec ./e2e/specs/data-exchange-persistence.e2e.mjs",
    "e2e:data-exchange-csv-write": "wdio run wdio.conf.mjs --spec ./e2e/specs/data-exchange-csv-write.e2e.mjs",
    "e2e:data-exchange-csv-persistence": "wdio run wdio.conf.mjs --spec ./e2e/specs/data-exchange-csv-persistence.e2e.mjs",
    "e2e:data-exchange-rollback": "wdio run wdio.conf.mjs --spec ./e2e/specs/data-exchange-rollback.e2e.mjs",
    "e2e:data-exchange-db-assert": "node e2e/assert-data-exchange-db.mjs",
    "e2e:data-exchange-export": "wdio run wdio.conf.mjs --spec ./e2e/specs/data-exchange-export.e2e.mjs",
    "e2e:data-exchange-export-roundtrip": "wdio run wdio.conf.mjs --spec ./e2e/specs/data-exchange-export-roundtrip.e2e.mjs",
    "e2e:data-exchange-export-assert": "node e2e/assert-contract-export.mjs",
    "e2e:data-exchange-export-prepare": "node e2e/prepare-contract-export-db.mjs",
    "test:e2e": "node e2e/run-e2e.mjs",
    "prisma:validate": "prisma validate",
    "database:registry": "python3 harness/scripts/database_contract_checks.py --registry-only",
    "database:diff": "prisma migrate diff --exit-code --from-migrations database/prisma/migrations --to-schema database/prisma/schema.prisma",
    "database:contract": "run-s database:registry database:diff",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "harness:check": "python3 harness/scripts/run_qa.py",
    "qa": "run-s lint typecheck test:unit prisma:validate database:contract test:db build tauri:check harness:check",
    "verify": "run-s qa test:e2e"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "dayjs": "1.11.21",
    "pinia": "3.0.4",
    "vue": "3.5.41",
    "vue-router": "4.6.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "@tsconfig/node24": "24.0.4",
    "@types/node": "26.1.2",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.1",
    "@wdio/cli": "9.30.1",
    "@wdio/globals": "9.29.1",
    "@wdio/jasmine-framework": "9.30.1",
    "@wdio/local-runner": "9.30.1",
    "@wdio/spec-reporter": "9.30.1",
    "@wdio/tauri-plugin": "1.3.0",
    "@wdio/tauri-service": "1.3.0",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "happy-dom": "20.11.1",
    "npm-run-all2": "8.0.4",
    "prisma": "7.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "vue-eslint-parser": "10.3.0",
    "vue-tsc": "3.3.9"
  }
}
