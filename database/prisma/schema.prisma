datasource db {
  provider = "sqlite"
}

model Customer {
  id                String             @id @default(uuid())
  name              String
  birthDate         String?            @map("birth_date")
  gender            String?
  phone             String?
  address           String?
  memo              String?
  status            String?
  isManaged         Boolean            @default(true) @map("is_managed")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at")
  deletedAt         DateTime?          @map("deleted_at")
  insurancePolicies InsurancePolicy[]
  familyMemberships FamilyMembership[]
  consultations     Consultation[]

  @@index([deletedAt])
  @@index([name, deletedAt])
  @@index([status, deletedAt])
  @@index([isManaged, deletedAt])
  @@map("customers")
}

model Consultation {
  id            String    @id @default(uuid())
  customerId    String    @map("customer_id")
  consultedAt   DateTime  @map("consulted_at")
  content       String?
  nextContactOn String?   @map("next_contact_on")
  result        String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([customerId, deletedAt, consultedAt])
  @@map("consultations")
}

model InsurancePolicy {
  id                String     @id @default(uuid())
  customerId        String     @map("customer_id")
  insurer           String
  productName       String     @map("product_name")
  joinedOn          String?    @map("joined_on")
  coverageTerm      String?    @map("coverage_term")
  paymentTerm       String?    @map("payment_term")
  monthlyPremiumWon BigInt     @map("monthly_premium_won")
  disclosurePlan    String?    @map("disclosure_plan")
  maturesOn         String?    @map("matures_on")
  renewable         Boolean    @default(false)
  status            String?
  isIncluded        Boolean    @default(true) @map("is_included")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at")
  deletedAt         DateTime?  @map("deleted_at")
  customer          Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  coverages         Coverage[]

  @@index([customerId, deletedAt])
  @@index([maturesOn, deletedAt])
  @@map("insurance_policies")
}

model CoverageCategory {
  id        String     @id @default(uuid())
  name      String
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")
  coverages Coverage[]

  @@index([deletedAt, name])
  @@map("coverage_categories")
}

model Coverage {
  id         String           @id @default(uuid())
  policyId   String           @map("policy_id")
  categoryId String           @map("category_id")
  amountWon  BigInt           @map("amount_won")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime?        @map("deleted_at")
  policy     InsurancePolicy  @relation(fields: [policyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category   CoverageCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([policyId, deletedAt])
  @@index([categoryId, deletedAt])
  @@map("coverages")
}

model Family {
  id          String             @id @default(uuid())
  name        String
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")
  memberships FamilyMembership[]

  @@index([deletedAt, name])
  @@map("families")
}

model FamilyMembership {
  id               String    @id @default(uuid())
  familyId         String    @map("family_id")
  customerId       String    @map("customer_id")
  relationshipName String?   @map("relationship_name")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  family           Family    @relation(fields: [familyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([familyId, customerId])
  @@index([familyId, deletedAt])
  @@index([customerId, deletedAt])
  @@map("family_memberships")
}
